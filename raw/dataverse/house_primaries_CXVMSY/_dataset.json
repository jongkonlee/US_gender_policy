ierScheme": {"typeName": "authorIdentifierScheme", "multiple": false, "typeClass": "controlledVocabulary", "value": "ORCID"}, "authorIdentifier": {"typeName": "authorIdentifier", "multiple": false, "typeClass": "primitive", "value": "0000-0001-5615-9828"}}, {"authorName": {"typeName": "authorName", "multiple": false, "typeClass": "primitive", "value": "Camberg, Nicki"}, "authorAffiliation": {"typeName": "authorAffiliation", "multiple": false, "typeClass": "primitive", "value": "Barnard College, Columbia University"}}]}, {"typeName": "datasetContact", "multiple": true, "typeClass": "compound", "value": [{"datasetContactName": {"typeName": "datasetContactName", "multiple": false, "typeClass": "primitive", "value": "Miller, Michael"}, "datasetContactAffiliation": {"typeName": "datasetContactAffiliation", "multiple": false, "typeClass": "primitive", "value": "Barnard College, Columbia University"}, "datasetContactEmail": {"typeName": "datasetContactEmail", "multiple": false, "typeClass": "primitive", "value": "mikemiller90@gmail.com"}}]}, {"typeName": "dsDescription", "multiple": true, "typeClass": "compound", "value": [{"dsDescriptionValue": {"typeName": "dsDescriptionValue", "multiple": false, "typeClass": "primitive", "value": "This dataset compiles primary election results for Democratic and Republican U.S. House candidates running in elections from 2012 to 2018. The data include results from all states except those conducting “top two primaries” (California and Washington for the entirety of this time period) as well as from Louisiana, which does not hold traditional primary elections. \n\nThese data were collected by Michael G. Miller (mgmiller@barnard.edu) and Nicki Camberg, both of Barnard College. If you publish with these data, please cite as:\n\nMiller, Michael G., and Nicki Camberg. 2020. “U.S. House Primary Election Results (2012-2018).” Harvard Dataverse, Version 1. \n\nThis file employs the same architecture as the following dataset:\n\nPettigrew, Stephen; Owen, Karen; Wanless, Emily, 2014, \"U.S. House Primary Election Results (1956-2010),\" available at https://doi.org/10.7910/DVN/26448. Current version information can be found at the preceding link. \n\nThis dataset can therefore be used as a stand-alone file, or can be appended to Pettigrew et al. to yield primary election data for years 1956 to 2018. If users append this dataset to Pettigrew et al., both datasets should be cited."}}]}, {"typeName": "subject", "multiple": true, "typeClass": "controlledVocabulary", "value": ["Social Sciences"]}, {"typeName": "keyword", "multiple": true, "typeClass": "compound", "value": [{"keywordValue": {"typeName": "keywordValue", "multiple": false, "typeClass": "primitive", "value": "Congressional Elections"}}, {"keywordValue": {"typeName": "keywordValue", "multiple": false, "typeClass": "primitive", "value": "Primary Elections"}}, {"keywordValue": {"typeName": "keywordValue", "multiple": false, "typeClass": "primitive", "value": "Election Returns"}}]}, {"typeName": "depositor", "multiple": false, "typeClass": "primitive", "value": "Miller, Michael"}, {"typeName": "dateOfDeposit", "multiple": false, "typeClass": "primitive", "value": "2020-12-02"}]}}, "files": [{"description": "Codebook accompanying data file.", "label": "Codebook.pdf", "restricted": false, "version": 1, "datasetVersionId": 225587, "dataFile": {"id": 4203036, "persistentId": "", "filename": "Codebook.pdf", "contentType": "application/pdf", "friendlyType": "Adobe PDF", "filesize": 558216, "description": "Codebook accompanying data file.", "storageIdentifier": "s3://dvn-cloud:17625312676-25ec7679a0cd", "rootDataFileId": -1, "md5": "a941b806d01366a9b61c72ac91fee972", "checksum": {"type": "MD5", "value": "a941b806d01366a9b61c72ac91fee972"}, "tabularData": false, "creationDate": "2020-12-02", "publicationDate": "2020-12-22", "lastUpdateTime": "2021-04-30T19:49:32Z", "fileAccessRequest": false}}, {"label": "house_primary_2012_2018.tab", "restricted": false, "version